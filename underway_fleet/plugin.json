    {
      "name": "order",
      "type": "select",
      "label": "Order",
      "default": "nearest",
      "choices": [
        {
          "value": "nearest",
          "label": "Nearest first"
        },
        {
          "value": "largest",
          "label": "Largest first"
        },
        {
          "value": "fastest",
          "label": "Fastest first"
